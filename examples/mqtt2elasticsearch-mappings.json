{
  "com/github/repositories/metrics/#": {
    "elasticIndex": "github-repositories-metrics-{Y}-{m}",
    "elasticBody": {
      "settings": {
        "index": {
          "number_of_shards": 5,
          "number_of_replicas": 0
        }
      },
      "mappings": {
        "properties": {
          "timestamp": { "type": "date" },
          "id": { "type": "integer" },
          "node_id": { "type": "keyword" },
          "name": { "type": "keyword" },
          "full_name": { "type": "keyword" },
          "private": { "type": "boolean" },
          "owner": {
            "properties": {
              "login": { "type": "keyword" },
              "id": { "type": "integer" },
              "node_id": { "type": "keyword" },
              "avatar_url": { "type": "text" },
              "gravatar_id": { "type": "keyword" },
              "url": { "type": "text" },
              "html_url": { "type": "text" },
              "followers_url": { "type": "text" },
              "following_url": { "type": "text" },
              "gists_url": { "type": "text" },
              "starred_url": { "type": "text" },
              "subscriptions_url": { "type": "text" },
              "organizations_url": { "type": "text" },
              "repos_url": { "type": "text" },
              "events_url": { "type": "text" },
              "received_events_url": { "type": "text" },
              "type": { "type": "keyword" },
              "user_view_type": { "type": "keyword" },
              "site_admin": { "type": "boolean" }
            }
          },
          "html_url": { "type": "text" },
          "description": { "type": "text" },
          "fork": { "type": "boolean" },
          "url": { "type": "text" },
          "forks_url": { "type": "text" },
          "keys_url": { "type": "text" },
          "collaborators_url": { "type": "text" },
          "teams_url": { "type": "text" },
          "hooks_url": { "type": "text" },
          "issue_events_url": { "type": "text" },
          "events_url": { "type": "text" },
          "assignees_url": { "type": "text" },
          "branches_url": { "type": "text" },
          "tags_url": { "type": "text" },
          "blobs_url": { "type": "text" },
          "git_tags_url": { "type": "text" },
          "git_refs_url": { "type": "text" },
          "trees_url": { "type": "text" },
          "statuses_url": { "type": "text" },
          "languages_url": { "type": "text" },
          "stargazers_url": { "type": "text" },
          "contributors_url": { "type": "text" },
          "subscribers_url": { "type": "text" },
          "subscription_url": { "type": "text" },
          "commits_url": { "type": "text" },
          "git_commits_url": { "type": "text" },
          "comments_url": { "type": "text" },
          "issue_comment_url": { "type": "text" },
          "contents_url": { "type": "text" },
          "compare_url": { "type": "text" },
          "merges_url": { "type": "text" },
          "archive_url": { "type": "text" },
          "downloads_url": { "type": "text" },
          "issues_url": { "type": "text" },
          "pulls_url": { "type": "text" },
          "milestones_url": { "type": "text" },
          "notifications_url": { "type": "text" },
          "labels_url": { "type": "text" },
          "releases_url": { "type": "text" },
          "deployments_url": { "type": "text" },
          "created_at": { "type": "date" },
          "updated_at": { "type": "date" },
          "pushed_at": { "type": "date" },
          "git_url": { "type": "text" },
          "ssh_url": { "type": "text" },
          "clone_url": { "type": "text" },
          "svn_url": { "type": "text" },
          "homepage": { "type": "text" },
          "size": { "type": "integer" },
          "stargazers_count": { "type": "integer" },
          "watchers_count": { "type": "integer" },
          "language": { "type": "keyword" },
          "has_issues": { "type": "boolean" },
          "has_projects": { "type": "boolean" },
          "has_downloads": { "type": "boolean" },
          "has_wiki": { "type": "boolean" },
          "has_pages": { "type": "boolean" },
          "has_discussions": { "type": "boolean" },
          "forks_count": { "type": "integer" },
          "mirror_url": { "type": "text" },
          "archived": { "type": "boolean" },
          "disabled": { "type": "boolean" },
          "open_issues_count": { "type": "integer" },
          "license": {
            "properties": {
              "key": { "type": "keyword" },
              "name": { "type": "keyword" },
              "spdx_id": { "type": "keyword" },
              "url": { "type": "text" },
              "node_id": { "type": "keyword" }
            }
          },
          "allow_forking": { "type": "boolean" },
          "is_template": { "type": "boolean" },
          "web_commit_signoff_required": { "type": "boolean" },
          "topics": { "type": "keyword" },
          "visibility": { "type": "keyword" },
          "forks": { "type": "integer" },
          "open_issues": { "type": "integer" },
          "watchers": { "type": "integer" },
          "default_branch": { "type": "keyword" },
          "temp_clone_token": { "type": "keyword" },
          "network_count": { "type": "integer" },
          "subscribers_count": { "type": "integer" }
        }
      }
    }
  }
}
